<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Cinema Sign</title>

<style>
html, body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    overflow:hidden;
    background:#181818;
    font-family:Arial, Helvetica, sans-serif;
}

#text{
    position:absolute;

    /* Vị trí */
    top:20px;
    left:30px;

    /* Chữ */
    color:#F5F5F5;
    font-size:260px;
    font-weight:900;

    /* Hiệu ứng */
    text-shadow:
        0 0 6px rgba(255,255,255,.35),
        0 0 12px rgba(255,255,255,.18);

    user-select:none;
}
</style>

</head>

<body>

<div id="text">A</div>

</body>
</html>
